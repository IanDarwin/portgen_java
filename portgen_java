#!/usr/local/jdk-25/bin/java --source 25

// For generating OpenBSD ports of Maven-based Java programs.
// Proof-of-concept version for fetching all deps in advance,
// as needed by OpenBSD ports build process.

import java.io.*;
import java.nio.file.attribute.BasicFileAttributes;
import java.util.*;
import java.nio.file.*;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

import javax.xml.parsers.DocumentBuilder;
import javax.xml.parsers.DocumentBuilderFactory;

import org.w3c.dom.Document;

public class PortGenJava {

	final static String MAKEFILE_TEMPLATE = """
			# Makefile for ${name} - generated by portgen_java
			# You'll need to do a lot of editing before committing this!
			# Run portcheck when you think you might be done.
			COMMENT=	What is this program even for?
			V=		${version}
			DISTNAME=	${name}-${V}
			PKG_ARCH=	*
			# set this to where to download the source archive
			SITES=	XXX
			EXTRACT_SUFX=	.tgz
			# Stop Make from trying to extract the dependant Jar files
			EXTRACT_ONLY= ${name}-${V}${EXTRACT_SUFX}
			# lots of deps; make sure this doesn't conflict:
			DIST_SUBDIR=	${name}
			
			# These categories may not apply to your app!
			CATEGORIES= java devel
			MODULES=		java
			# Use a current release:
			MODJAVA_VER=		25+
			
			RUN_DEPENDS+=	java/javaPathHelper
			
			PERMIT_PACKAGE=	XXX Change to Yes after verifying, and add license marker
			NO_TEST=		Yes
			
			do-build:
				cd ${WRKDIR}/${name}; mvn -Dmaven.repo.local=${WRKDIR}/${name} compile test package assembly:single
			
			do-install:
				@echo If this isn't right, figure out where to install the JAR file, and do so here:
				${INSTALL_DATA} ${WORKDIR}/target/${name}-${version}-jar-with-dependencies.jar /usr/local/lib/java/
				@echo Consider a startup file (using javaPathHelper) in /usr/local/bin or /etc/rc.d as appropriate.
			
			SITES.maven= https://repo1.maven.org/maven2/
			DISTFILES.maven	= \\
			${distfiles_list}
			
			.include <bsd.port.mk>
			""";

	final static String MYSTUFF = "/usr/ports/mystuff/java/";

	// Command-line settables
	static boolean update = false;
	static boolean debug = true; // XXX Make false someday
	static boolean keep = false;
	static boolean verbose = false;

	void main(String[] args) throws Exception {

		// Trivial arg parsing
		if (args.length == 0) {
			usage();
		}

		Path targetPomPath = null;
        for (String arg : args) {
            switch (arg) {
                case "-d":
                    debug = true;
                    break;
                case "-u":
                    update = true;
                    break;
                case "-k":
                    keep = true;
                    break;
                case "-v":
                    verbose = true;
                    break;
                default:
                    targetPomPath = Path.of(arg);
            }
        }
		if (targetPomPath== null) {
			usage();
		}
		if (!Files.isReadable(targetPomPath)) {
			throw new FileNotFoundException("Cannot read " + targetPomPath + ".");
		}

		Document doc = readDoc(targetPomPath);
		var project = doc.getDocumentElement();
		var name = project.getElementsByTagName("artifactId").item(0).getTextContent();
		var version = project.getElementsByTagName("version").item(0).getTextContent();
		if (version.contains("SNAPSHOT")) {
			System.err.println("Error: Snapshot version in pom file");
			System.exit(1);
		}
		System.out.printf("Artifact Name %s, Version %s\n", name, version);

		Path mystuffdir = Path.of(MYSTUFF + name + "/");
		if (Files.isDirectory(mystuffdir)) {
			if (update) {
				// Do nothing; let user decide.
			} else {
				System.err.println("Error: output directory exists: " + mystuffdir);
				System.exit(1);
			}
		}
		Files.createDirectories(mystuffdir);
		Path pkgPath = Files.createDirectories(mystuffdir.resolve("pkg"));
		final Path descrPath = pkgPath.resolve("DESCR");
		if (!Files.exists(descrPath)) {
			Files.writeString(descrPath, "XXX Put a brief description of the program here");
		}

		// Get list of deps
		List<Dependency> dependencies = deps(targetPomPath);

		StringBuilder flist = new StringBuilder();
		dependencies
			.stream()
			.skip(1)
			.forEach((d -> {
				for (String ext : new String[]{".pom", ".jar"}) {
					flist.append('\t' + d.toMavenURL() + ext + " \\\n");
				}
        	}
		));

		// DO THE THING HERE:
		// Create generated Makefile in $mystuff/java/name
		String makefile = MAKEFILE_TEMPLATE
				.replace("${name}", name)
				.replace("${version}", version)
				.replace("${distfiles_list}", flist.toString());
		Files.writeString(Path.of(mystuffdir + "/Makefile"), makefile);

		System.out.println("Makefile generated in " + mystuffdir + "/Makefile - check it out!");
	}

	// print usage and exit
	void usage() {
		System.err.println("Usage: portgen_java source_directory");
		System.exit(1);
	}

	/**
	 * Read the XML document
	 */
	Document readDoc(Path path) throws Exception {
		DocumentBuilderFactory fact = DocumentBuilderFactory.newInstance();
		fact.setIgnoringComments(false);
		DocumentBuilder parser = fact.newDocumentBuilder();
		Document doc = parser.parse(Files.newInputStream(path));
		return doc;
	}

	/**
	 * Remove entire directory tree (stolen from FileVisitor javadoc)
	 */
	void nukeDir(Path p) throws IOException {
		Files.walkFileTree(p, new SimpleFileVisitor<Path>() {
			@Override
			public FileVisitResult visitFile(Path file, BasicFileAttributes attrs) throws IOException {
				Files.delete(file);
				return FileVisitResult.CONTINUE;
			}

			@Override
			public FileVisitResult postVisitDirectory(Path dir, IOException e) throws IOException {
				if (e == null) {
					Files.delete(dir);
					return FileVisitResult.CONTINUE;
				} else {
					// directory iteration failed
					throw e;
				}
			}
		});
	}

	/**
	 * Record one Maven/Gradle-style dependency
	 */
	record Dependency(String groupId, String artifactId, String version) {

		// Convert the Dependency to the URL portion of a Maven Central download
		// Sample: https://repo.maven.apache.org/maven2/commons-io/commons-io/2.6/commons-io-2.6.pom
		String toMavenURL() {
			return String.format("%s/%s/%s/%s-%s",
					tos(groupId), artifactId, version, artifactId, version);
		}

		// Convert from eg org.apache.commons to org/apache/commons
		private String tos(String s) {
			return s.replace('.', '/');
		}
	}

	final static String PATTERN = "([\\w.-]+):([\\w.-]+):\\w+:([\\w.-]+):?.*";
	final static Pattern RE = Pattern.compile(PATTERN);

	public static List<Dependency> deps(Path pomFile) throws Exception {
		return new BufferedReader(new InputStreamReader(
				new ProcessBuilder("mvn", "-f", pomFile.toString(), "dependency:tree").start().getInputStream()))
				.lines()
				.map(s -> s.replaceAll("^\\[INFO\\] ([|  \\\\+-]*)?", ""))
				.filter(s -> RE.matcher(s).matches())
				.map(s1 -> {
					Matcher m = RE.matcher(s1);
					if (!m.matches())
						throw new IllegalArgumentException("Line did not match: " + s1);
					return new Dependency(m.group(1), m.group(2), m.group(3));
				})
				.toList();
	}
}

