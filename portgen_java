#!/usr/local/jdk-25/bin/java --source 25

// For generating OpenBSD ports from Maven-based Java programs.
// Proof-of-concept version for fetching all deps in advance,
// as needed by OpenBSD ports builders.

import java.io.*;
import java.util.*;
import java.nio.file.*;

import javax.xml.parsers.DocumentBuilder;
import javax.xml.parsers.DocumentBuilderFactory;

import org.w3c.dom.Document;
import org.w3c.dom.Node;
import org.w3c.dom.NodeList;

final static String MAKEFILE_TEMPLATE = """
# Makefile for ${name} - originally made by portgen_java
# You'll need to do a lot of editing before committing this!
DISTNAME=	${name}-${version}
PKGNAME=	${name}
PKG_ARCH=	*
CATEGORIES= java devel
MASTER_SITES=	# Where to get a source archive
SITES.maven= https://repo1.maven.org/maven2/
EXTRACT_SUFX=	.jar
EXTRACT_SUBDIR=	${name} # make sure this doesn't conflict

MODULES=		java
MODJAVA_VER=		25+	# Use a current release.

DISTFILES.maven	= \\
${distfiles_list}

RUN_DEPENDS+=		devel/desktop-file-utils \\
			java/javaPathHelper
			# java/standardMavenFiles

NO_BUILD=		Yes
NO_TEST=		Yes

do_build:
	cd ${WRKDIR}
	mvn compile test package assembly:single

do_install:
	@echo If this isn't right, figure out where to install the JAR file, and do so here:
	${INSTALL_DATA} ${WORKDIR}/target/${name}-${version}-jar-with-dependencies.jar /usr/local/lib/java/
	@echo Consider a startup file in /usr/local/bin or /etc/rc.d as appropriate.

.include <bsd.port.mk>
""";
static Path USER_REPO_PATH;
final static String SETTINGS_TEMPLATE = "/usr/local/share/java/portgen_java/settings.template";
final static String SETTINGS_FILE = System.getProperty("user.home") + "/portgen_java/settings.xml"; // XXX
final static String MYSTUFF = "/usr/ports/mystuff/java/";

// Command-line settables
static boolean force = false;
static boolean debug = true; // Make false someday
static boolean keep = false;
static boolean verbose = false;

void main(String[] args) throws Exception {

	String targetDir = null;

	// Trivial arg parsing
	if (args.length == 0) {
		usage();
	}
	for (int i = 0; i < args.length; i++) {
		String arg = args[i];
		switch(arg) {
			case "-d": debug = true; break;
			case "-f": force = true; break;
			case "-k": keep = true; break;
			case "-v": verbose = true; break;
			default: targetDir = arg;
		}
	}
	if (args == null) {
		usage();
	}

	var pom = Path.of(targetDir + "/pom.xml");
	if (!Files.isReadable(pom)) {
		System.err.println("Cannot locate " + pom + ". Run in Java source directory.");
	}

	Document doc = readDoc(pom);
	var project = doc.getDocumentElement();
	var name = project.getElementsByTagName("artifactId").item(0).getTextContent();
	var version = project.getElementsByTagName("version").item(0).getTextContent();

	if (version.contains("SNAPSHOT")) {
		System.out.println("Error: Snapshot version in pom file");
		System.exit(1);
	}
	System.out.printf("Artifact Name %s, Version %s\n", name, version);

	Path mystuffdir = Path.of(MYSTUFF + name + "/");
	if (Files.isDirectory(mystuffdir)) {
		if (force) {
			// Do nothing; let user decide.
		} else {
			System.out.println("Error: output directory exists: " + mystuffdir);
			System.exit(1);
		}
	}

	// Generate local 'settings.xml' for Maven, using the generated tmp repo
	// We have to create the temporary local repo first so we can insert into this file.
	USER_REPO_PATH = Files.createTempDirectory("portgenjava");
	if (debug) {
		System.out.println("User Repository is " + USER_REPO_PATH);
	}
	String settingsTemplate = Files.readString(Path.of(SETTINGS_TEMPLATE));
	settingsTemplate = settingsTemplate.replace("${user-repo}", USER_REPO_PATH.toString());
	Files.writeString(Path.of(SETTINGS_FILE), settingsTemplate);

	// XXX Copy the system jars here, adding them to a Set<String>

	// Now run Maven to just get the app-specific dependencies
	String[] newArgsArray = {"mvn", "-s", SETTINGS_FILE, "dependency:go-offline"};
	List<String> newArgs = Arrays.asList(newArgsArray);
	if (debug) {
		System.out.println("Dir:  " + targetDir);
		System.out.println("Args: " + newArgs);
	}
	ProcessBuilder builder = new ProcessBuilder(newArgs);
	final Process maven = builder.directory(new File(targetDir)).start();
	// Optionally copy its stdout to ours
	System.out.println("Downloading...");
	if (debug) {
		BufferedReader is = maven.inputReader();
		String line;
		while ((line = is.readLine()) != null) {
			if (verbose || !line.startsWith("[INFO]")) {
				System.out.println(line);
			}
		}
	}
	System.err.println("Waiting for the end (of the maven)");			 
	int ret = maven.waitFor();
	if (ret != 0) {
		System.out.printf("Error: Maven get-deps failed, code %d\n", ret);
		System.exit(1);
	}

	// Create list of files that were downloaded.
	StringBuilder flist = new StringBuilder();
	Files.walk(USER_REPO_PATH)
		.filter(s -> s.toString().endsWith(".jar") | s.toString().endsWith(".pom") | s.toString().endsWith(".sha1"))
		.forEach(p->flist.append(p.toString().replaceAll(USER_REPO_PATH.toString(),"").substring(1)).append(" \\\n"));

	// Create generated Makefile in $mystuff/java/name
	Files.createDirectories(mystuffdir);
	String makefile = MAKEFILE_TEMPLATE
		.replace("${name}", name)
		.replace("${version}", version)
		.replace("${distfiles_list}", flist.toString());
	Files.writeString(Path.of(mystuffdir + "/Makefile"), makefile);

	System.out.println("Makefile generated in " + mystuffdir + "/Makefile - check it out!");

	// Clean up the user repo now that we have the PLIST info.
	if (keep) {
		System.out.println("Leaving deps in " + USER_REPO_PATH + ".");
	} else {
		System.out.println("Cleaning up " + USER_REPO_PATH + "...");
		nukeDir(USER_REPO_PATH);
	}
}

// print usage and exit
void usage() {
	System.err.println("Usage: portgen_java source_directory");
	System.exit(1);
}

/** Read the XML document */
Document readDoc(Path path) throws Exception {
	DocumentBuilderFactory fact = DocumentBuilderFactory.newInstance();
	fact.setIgnoringComments(false);
	DocumentBuilder parser = fact.newDocumentBuilder();
	Document doc = parser.parse(Files.newInputStream(path));
	return doc;
}

/** Remove entire directory tree (stolen from FileVisitor javadoc) */
void nukeDir(Path p) throws IOException {
	Files.walkFileTree(p, new SimpleFileVisitor<Path>() {
         @Override
         public FileVisitResult visitFile(Path file, BasicFileAttributes attrs) throws IOException {
             Files.delete(file);
             return FileVisitResult.CONTINUE;
         }
         @Override
         public FileVisitResult postVisitDirectory(Path dir, IOException e) throws IOException {
             if (e == null) {
                 Files.delete(dir);
                 return FileVisitResult.CONTINUE;
             } else {
                 // directory iteration failed
                 throw e;
             }
         }
     });
}
